.DS_Store
Thumbs.db
*.swp
*~

# R package build artifacts
*.o
*.so
*.dll
.Rproj.user
.Rhistory

# Documentation build
# NOTE: `docs/` is pkgdown's OUTPUT directory (built by CI and pushed to
# gh-pages), so it must never contain hand-written files. The two reference
# manuals that `?calculate` points at live in `inst/reference/` instead and are
# installed with the package; the repository keeps a copy at `docs_src/`.
/docs/
site_local/
vign_preview/
*_files/
vignettes/*_files/
*.html

# Temporary files
tmp/
temp/
*.tmp

# Reference literature PDFs are kept locally only and never pushed.
# (.Rbuildignore also excludes them from the package tarball.)
references/

# Local commit message drafts
commit_msg*.txt
